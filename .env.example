# Required on the online host (Render): set these 3 as Environment Variables
GATEWAY_TOKEN=            # your own secret password to open the page (choose a long one)
SUPABASE_SERVICE_KEY=     # Supabase > Project Settings > API Keys > service_role (SECRET)
GEMINI_API_KEY=           # aistudio.google.com (free)
# Optional
GEMINI_MODEL=gemini-2.5-flash
